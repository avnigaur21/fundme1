# Supabase: use the Project URL and server-side service_role key.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_KEY=YOUR_SERVICE_ROLE_KEY

# AI (at least one is required for profile extraction/matching/drafts)
GROQ_API_KEY=
OPENROUTER_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free
# Set a long random secret in deployment so sessions survive backend restarts.
# When omitted locally, restarting the backend requires signing in again.
SESSION_SECRET=
GOOGLE_API_KEY=

# Cloudinary document uploads (optional until /api/upload is used)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

PORT=5000
SCRAPE_ON_STARTUP=true
NODE_ENV=development
